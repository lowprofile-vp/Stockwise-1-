# Supabase project URL and publishable key. Project Settings → API.
# Leave both empty to use the built-in login and the local SQLite demo.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional: only for projects still on the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# Required in production when Supabase is not configured. The development default is rejected when FLASK_ENV=production.
JWT_SECRET_KEY=replace-with-a-long-random-string
SECRET_KEY=replace-with-a-long-random-string

FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Comma-separated browser origins, no trailing slash. Patterns such as https://*.vercel.app work.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Set to 0 in production so password-reset responses never include a token.
RETURN_RESET_TOKEN=1

# Optional SMTP. When SMTP_HOST is empty, reset links are not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@stockwise.local
